PORT=4000
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CLIENT_URL=http://localhost:3000

# Optional. Verification and password-reset emails go to Mailpit
# (http://localhost:8026) with docker compose; leave empty to print them to
# the console instead.
SMTP_URL=smtp://localhost:1026
MAIL_FROM="Shop <no-reply@localhost>"

# Reverse proxies in front of the API (the rate limiter keys on client IP).
TRUST_PROXY=1
