// DAX measures of the Power BI semantic model, generated by src/build_powerbi.py.
// Definitions match docs/kpi_dictionary.md and the SQL views (sql/00_schema.sql).
// Star schema: FactSales / FactOrders / FactInventoryDaily -> DimDate, DimProduct,
//              DimCustomer, DimChannel, DimGeography (see powerbi/README.md).

// ---- FactSales -------------------------------------------------------------

// List-price value of fulfilled lines, before discounts
Gross Sales =
    SUM ( FactSales[gross_amount] )

// Discount given on fulfilled lines
Discounts =
    SUM ( FactSales[discount_amount] )

// Refunded amount, allocated to lines by value
Refunds =
    SUM ( FactSales[refund_amount] )

// Gross sales - discounts - refunds; cancelled orders excluded
Net Revenue =
    SUM ( FactSales[net_revenue] )

// Units x unit cost
Cost of Goods =
    SUM ( FactSales[cogs] )

// Carrier cost paid by the shop, allocated to lines by parcel weight
Shipping Cost =
    SUM ( FactSales[shipping_cost] )

// Net revenue - COGS - shipping
Gross Profit =
    [Net Revenue] - [Cost of Goods] - [Shipping Cost]

// Gross profit / net revenue
Gross Margin % =
    DIVIDE ( [Gross Profit], [Net Revenue] )

Discount Rate % =
    DIVIDE ( [Discounts], [Gross Sales] )

Units Sold =
    SUM ( FactSales[quantity] )

// Previous month
Net Revenue PM =
    CALCULATE ( [Net Revenue], DATEADD ( DimDate[date], -1, MONTH ) )

MoM Growth % =
    DIVIDE ( [Net Revenue] - [Net Revenue PM], [Net Revenue PM] )

// Same period last year
Net Revenue PY =
    CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( DimDate[date] ) )

YoY Growth % =
    DIVIDE ( [Net Revenue] - [Net Revenue PY], [Net Revenue PY] )

Gross Profit PY =
    CALCULATE ( [Gross Profit], SAMEPERIODLASTYEAR ( DimDate[date] ) )

Gross Profit YoY % =
    DIVIDE ( [Gross Profit] - [Gross Profit PY], [Gross Profit PY] )

Gross Margin PY =
    CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( DimDate[date] ) )

// Percentage points vs same period last year
Gross Margin Change pp =
    IF ( NOT ISBLANK ( [Gross Margin PY] ), ( [Gross Margin %] - [Gross Margin PY] ) * 100 )

Returning Customer Revenue =
    CALCULATE ( [Net Revenue], FactSales[customer_type] = "Returning" )

// Share of net revenue from customers who had bought before
Returning Customer Revenue % =
    DIVIDE ( [Returning Customer Revenue], [Net Revenue] )

Product Revenue Rank =
    IF ( HASONEVALUE ( DimProduct[product_name] ), RANKX ( ALL ( DimProduct[product_name] ), [Net Revenue] ) )

Product Profit Rank =
    IF ( HASONEVALUE ( DimProduct[product_name] ), RANKX ( ALL ( DimProduct[product_name] ), [Gross Profit] ) )

// ---- FactOrders ------------------------------------------------------------

// Fulfilled orders
Orders =
    CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[is_fulfilled] = TRUE () )

// Including cancelled
Orders Placed =
    COUNTROWS ( FactOrders )

Orders PY =
    CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( DimDate[date] ) )

Orders YoY % =
    DIVIDE ( [Orders] - [Orders PY], [Orders PY] )

// Average order value: net revenue / fulfilled orders
AOV =
    DIVIDE ( SUM ( FactOrders[net_revenue] ), [Orders] )

AOV PY =
    CALCULATE ( [AOV], SAMEPERIODLASTYEAR ( DimDate[date] ) )

AOV YoY % =
    DIVIDE ( [AOV] - [AOV PY], [AOV PY] )

// Active customers (guests excluded)
Customers =
    CALCULATE ( DISTINCTCOUNT ( FactOrders[customer_id] ), FactOrders[is_fulfilled] = TRUE (), NOT ISBLANK ( FactOrders[customer_id] ) )

// Customers whose first fulfilled order is in the period
New Customers =
    CALCULATE ( [Customers], FactOrders[customer_type] = "New" )

Returning Customers =
    CALCULATE ( [Customers], FactOrders[customer_type] = "Returning" )

// Share of active customers who had bought before
Repeat Rate % =
    DIVIDE ( [Returning Customers], [Customers] )

Revenue per Customer =
    DIVIDE ( CALCULATE ( SUM ( FactOrders[net_revenue] ), NOT ISBLANK ( FactOrders[customer_id] ) ), [Customers] )

// Refunded / fulfilled orders
Refund Rate % =
    DIVIDE ( CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[status] = "refunded" ), [Orders] )

Refund Rate PY =
    CALCULATE ( [Refund Rate %], SAMEPERIODLASTYEAR ( DimDate[date] ) )

Cancellation Rate % =
    DIVIDE ( CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[status] = "cancelled" ), [Orders Placed] )

On-time Delivery % =
    DIVIDE ( CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[is_fulfilled] = TRUE (), FactOrders[is_late] = FALSE () ), [Orders] )

// ---- FactInventoryDaily ----------------------------------------------------

// Share of product-days with no stock
Stockout Rate % =
    DIVIDE ( CALCULATE ( COUNTROWS ( FactInventoryDaily ), FactInventoryDaily[is_stockout] = TRUE () ), COUNTROWS ( FactInventoryDaily ) )

// Stockout days x demand on in-stock days x net price (upper bound)
Estimated Lost Sales =
    SUM ( FactInventoryDaily[est_lost_revenue] )

// Average daily stock value at cost
Avg Inventory Value =
    AVERAGEX ( VALUES ( DimDate[date] ), CALCULATE ( SUM ( FactInventoryDaily[stock_value_at_cost] ) ) )

// COGS in the period / average stock value
Inventory Turnover =
    DIVIDE ( [Cost of Goods], [Avg Inventory Value] )

// ---- InventoryForecast -----------------------------------------------------

// Will run out before (or within 7 days of) a delivery ordered today
Products At Risk =
    CALCULATE ( COUNTROWS ( InventoryForecast ), InventoryForecast[risk] IN { "STOCKOUT BEFORE RESTOCK", "REORDER NOW" } )

A-class At Risk =
    CALCULATE ( [Products At Risk], InventoryForecast[abc_class] = "A" )

Revenue At Risk 30d =
    CALCULATE ( SUM ( InventoryForecast[revenue_at_risk_30d] ), InventoryForecast[risk] IN { "STOCKOUT BEFORE RESTOCK", "REORDER NOW" } )

// ---- DataQualityScorecard --------------------------------------------------

DQ Completeness =
    CALCULATE ( MAX ( DataQualityScorecard[completeness_pct] ), DataQualityScorecard[stage] = "clean" ) / 100

DQ Validity =
    CALCULATE ( MAX ( DataQualityScorecard[validity_pct] ), DataQualityScorecard[stage] = "clean" ) / 100

DQ Duplicates =
    CALCULATE ( MAX ( DataQualityScorecard[duplicates_pct] ), DataQualityScorecard[stage] = "clean" ) / 100

DQ Missing Values =
    CALCULATE ( MAX ( DataQualityScorecard[missing_values_pct] ), DataQualityScorecard[stage] = "clean" ) / 100

DQ Failed Checks (raw) =
    CALCULATE ( MAX ( DataQualityScorecard[failed_checks] ), DataQualityScorecard[stage] = "raw" )

DQ Failed Checks (clean) =
    CALCULATE ( MAX ( DataQualityScorecard[failed_checks] ), DataQualityScorecard[stage] = "clean" )
