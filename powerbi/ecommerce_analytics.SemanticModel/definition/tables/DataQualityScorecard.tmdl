		lineageTag: dd8b7418-4869-540d-8c7c-86639372c34a

	measure 'DQ Missing Values' = CALCULATE ( MAX ( DataQualityScorecard[missing_values_pct] ), DataQualityScorecard[stage] = "clean" ) / 100
