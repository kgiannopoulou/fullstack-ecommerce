		displayFolder: Data quality
		lineageTag: 9b96ea7c-3585-553d-a71d-382284c79f8a

	measure 'DQ Duplicates' = CALCULATE ( MAX ( DataQualityScorecard[duplicates_pct] ), DataQualityScorecard[stage] = "clean" ) / 100
