	partition DataQualityScorecard = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DataQualityScorecard.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"stage", type text}, {"records", Int64.Type}, {"completeness_pct", type number}, {"validity_pct", type number}, {"duplicates_pct", type number}, {"missing_values_pct", type number}, {"rules_checked", Int64.Type}, {"failed_checks", Int64.Type}, {"critical_failures", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
