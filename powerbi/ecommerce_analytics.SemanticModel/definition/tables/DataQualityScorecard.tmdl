table DataQualityScorecard
	lineageTag: 3b1b72b9-771d-52a5-90ec-60eea6c24922

	measure 'DQ Completeness' = CALCULATE ( MAX ( DataQualityScorecard[completeness_pct] ), DataQualityScorecard[stage] = "clean" ) / 100
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Data quality
		lineageTag: dc4852f0-993a-5556-8b19-b42a684378e6

	measure 'DQ Validity' = CALCULATE ( MAX ( DataQualityScorecard[validity_pct] ), DataQualityScorecard[stage] = "clean" ) / 100
