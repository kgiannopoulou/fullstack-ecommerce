	partition DimCustomer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DimCustomer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"customer_id", Int64.Type}, {"country", type text}, {"acquisition_channel", type text}, {"signup_date", type date}, {"first_order_date", type date}, {"cohort_month", type date}, {"orders", Int64.Type}, {"lifetime_revenue", type number}, {"recency_days", Int64.Type}, {"r_score", Int64.Type}, {"f_score", Int64.Type}, {"rfm_segment", type text}}, "en-US")
