	partition InventoryForecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "InventoryForecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"product_id", Int64.Type}, {"sku", type text}, {"product_name", type text}, {"category", type text}, {"abc_class", type text}, {"stock", Int64.Type}, {"forecast_30d", type number}, {"difference", type number}, {"days_cover", type number}, {"lead_time_days", Int64.Type}, {"risk", type text}, {"reorder_qty", type number}, {"expected_lost_units", type number}, {"avg_net_price", type number}, {"revenue_at_risk_30d", type number}, {"recommended_action", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
