table InventoryForecast
	lineageTag: 90df6af7-946a-5401-bb12-ba656b84bbb5

	/// Will run out before (or within 7 days of) a delivery ordered today
	measure 'Products At Risk' = CALCULATE ( COUNTROWS ( InventoryForecast ), InventoryForecast[risk] IN { "STOCKOUT BEFORE RESTOCK", "REORDER NOW" } )
		formatString: #,0
		displayFolder: Inventory
		lineageTag: fddf9311-5c01-5919-a7d9-817d2d48bb69

	measure 'A-class At Risk' = CALCULATE ( [Products At Risk], InventoryForecast[abc_class] = "A" )
		formatString: #,0
		displayFolder: Inventory
		lineageTag: 6e593f4d-5627-535e-b739-1661d073f92f

	measure 'Revenue At Risk 30d' = CALCULATE ( SUM ( InventoryForecast[revenue_at_risk_30d] ), InventoryForecast[risk] IN { "STOCKOUT BEFORE RESTOCK", "REORDER NOW" } )
		formatString: \€#,0
		displayFolder: Inventory
		lineageTag: d9e3e3c4-2fb2-511a-b4c3-541114c25f3e

