table FactOrders
	lineageTag: 12b33675-358b-511a-a72a-bbbfc4aaa5c0

	/// Fulfilled orders
	measure Orders = CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[is_fulfilled] = TRUE () )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 6067fede-602e-5b3d-8d50-101ae820e3f9

	/// Including cancelled
	measure 'Orders Placed' = COUNTROWS ( FactOrders )
		formatString: #,0
		displayFolder: Volume
		lineageTag: e7f56fd0-adf7-532c-8438-be80e5da2910

	measure 'Orders PY' = CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: #,0
		displayFolder: Time intelligence
		lineageTag: e40e2b2f-18e4-5cf0-94be-719f994e06f8

	measure 'Orders YoY %' = DIVIDE ( [Orders] - [Orders PY], [Orders PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: b7fbea1b-a09b-51a4-84b4-4dfef96eb620

	/// Average order value: net revenue / fulfilled orders
	measure AOV = DIVIDE ( SUM ( FactOrders[net_revenue] ), [Orders] )
		formatString: \€#,0.00
		displayFolder: Revenue
		lineageTag: 90642082-402a-5fa5-88fc-375b48dedff8

	measure 'AOV PY' = CALCULATE ( [AOV], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: \€#,0.00
		displayFolder: Time intelligence
		lineageTag: b5902c4a-20e6-5dda-93e7-ee9dac7fd763

	measure 'AOV YoY %' = DIVIDE ( [AOV] - [AOV PY], [AOV PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: 6cf5f7d7-b82f-5254-8ddf-6bb6a21c833a

	/// Active customers (guests excluded)
	measure Customers = CALCULATE ( DISTINCTCOUNT ( FactOrders[customer_id] ), FactOrders[is_fulfilled] = TRUE (), NOT ISBLANK ( FactOrders[customer_id] ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 5223f77e-b67f-576a-896b-34f75e1b1914

	/// Customers whose first fulfilled order is in the period
	measure 'New Customers' = CALCULATE ( [Customers], FactOrders[customer_type] = "New" )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 4c540484-c86a-5326-8b2a-aa833c7cd3ab

	measure 'Returning Customers' = CALCULATE ( [Customers], FactOrders[customer_type] = "Returning" )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 5c778565-da99-5244-a510-b3fab5d65075

	/// Share of active customers who had bought before
	measure 'Repeat Rate %' = DIVIDE ( [Returning Customers], [Customers] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customers
		lineageTag: ac3fdbbd-a01b-5386-a14e-37e3c86f5b5b

	measure 'Revenue per Customer' = DIVIDE ( CALCULATE ( SUM ( FactOrders[net_revenue] ), NOT ISBLANK ( FactOrders[customer_id] ) ), [Customers] )
		formatString: \€#,0.00
		displayFolder: Customers
		lineageTag: bccff6e8-cced-5b0a-a504-1d09e8a7efab

	/// Refunded / fulfilled orders
	measure 'Refund Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[status] = "refunded" ), [Orders] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations
		lineageTag: 99c25dc2-8b7e-5a2c-a38d-4d32b0dc431d

	measure 'Refund Rate PY' = CALCULATE ( [Refund Rate %], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Time intelligence
		lineageTag: 7c613baf-30bf-55bf-8b50-dca9b34aac8d

	measure 'Cancellation Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[status] = "cancelled" ), [Orders Placed] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations
		lineageTag: 5ea4bddd-315a-52f1-af0e-40c62430bb23

	measure 'On-time Delivery %' = DIVIDE ( CALCULATE ( COUNTROWS ( FactOrders ), FactOrders[is_fulfilled] = TRUE (), FactOrders[is_late] = FALSE () ), [Orders] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations
		lineageTag: 2ce1115b-c1cf-5473-b7a4-e275ae7d8426

