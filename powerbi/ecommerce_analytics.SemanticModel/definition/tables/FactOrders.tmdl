	partition FactOrders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactOrders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"order_id", Int64.Type}, {"customer_id", Int64.Type}, {"order_date", type date}, {"status", type text}, {"payment_method", type text}, {"channel_id", Int64.Type}, {"country", type text}, {"courier", type text}, {"customer_type", type text}, {"discount_pct", type number}, {"units", Int64.Type}, {"gross_amount", type number}, {"discount_amount", type number}, {"refund_amount", type number}, {"net_revenue", type number}, {"cogs", type number}, {"shipping_cost", type number}, {"gross_profit", type number}, {"days_to_ship", Int64.Type}, {"days_to_deliver", Int64.Type}, {"is_late", type logical}, {"is_fulfilled", type logical}, {"has_bulk", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
