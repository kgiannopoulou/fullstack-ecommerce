	partition FactSales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactSales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"transaction_id", type text}, {"order_id", Int64.Type}, {"customer_id", Int64.Type}, {"order_date", type date}, {"product_id", Int64.Type}, {"country", type text}, {"channel_id", Int64.Type}, {"customer_type", type text}, {"is_discounted", type logical}, {"quantity", Int64.Type}, {"gross_amount", type number}, {"discount_amount", type number}, {"refund_amount", type number}, {"net_revenue", type number}, {"cogs", type number}, {"shipping_cost", type number}, {"gross_profit", type number}, {"is_bulk", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
