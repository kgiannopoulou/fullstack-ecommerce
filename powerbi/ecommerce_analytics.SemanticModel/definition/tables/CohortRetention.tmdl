table CohortRetention
	lineageTag: a2ccbec2-3455-5e72-a0d2-6f3871958178

	column cohort
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 0bfef8fd-c60a-5d56-9821-86bf396f0071
		summarizeBy: none
		sourceColumn: cohort

		annotation SummarizationSetBy = Automatic

	column month_n
		dataType: int64
		formatString: 0
		lineageTag: 9c9b691b-3e77-56f7-b70d-cd37ae4bd59c
		summarizeBy: none
		sourceColumn: month_n

		annotation SummarizationSetBy = Automatic

	column customers
		dataType: int64
		formatString: #,0
		lineageTag: bc9537c7-606c-5376-a76e-be18a4160617
		summarizeBy: sum
		sourceColumn: customers

		annotation SummarizationSetBy = Automatic

	column cohort_size
		dataType: int64
		formatString: #,0
		lineageTag: db47427b-90e8-57de-9a7d-e170b46b1a00
		summarizeBy: none
		sourceColumn: cohort_size

		annotation SummarizationSetBy = Automatic

	column retention_pct
		dataType: double
		formatString: 0.0
		lineageTag: 8993e627-2e49-5400-96d2-408eac7a208d
		summarizeBy: sum
		sourceColumn: retention_pct

		annotation SummarizationSetBy = Automatic

	partition CohortRetention = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "CohortRetention.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"cohort", type date}, {"month_n", Int64.Type}, {"customers", Int64.Type}, {"cohort_size", Int64.Type}, {"retention_pct", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
