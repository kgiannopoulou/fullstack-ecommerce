model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "DimDate", "DimProduct", "DimCustomer", "DimChannel", "DimGeography", "FactSales", "FactOrders", "FactInventoryDaily", "InventoryForecast", "CohortRetention", "ManagementAlerts", "Anomalies", "DataQualityRules", "DataQualityScorecard"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table DimDate
ref table DimProduct
ref table DimCustomer
ref table DimChannel
ref table DimGeography
ref table FactSales
ref table FactOrders
ref table FactInventoryDaily
ref table InventoryForecast
ref table CohortRetention
ref table ManagementAlerts
ref table Anomalies
ref table DataQualityRules
ref table DataQualityScorecard
